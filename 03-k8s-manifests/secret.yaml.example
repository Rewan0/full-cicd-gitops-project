# Template only. 
# The .example extension keeps this file out of `kubectl apply -f .` and out of ArgoCD sync.
#
# Create the real Secret directly on the cluster:
#   kubectl create secret generic ivolve-secret -n ivolve \
#     --from-literal=MYSQL_ROOT_PASSWORD='<root-password>' \
#     --from-literal=DB_PASSWORD='<app-user-password>'
apiVersion: v1
kind: Secret
metadata:
  name: ivolve-secret
  namespace: ivolve
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: <root-password>
  DB_PASSWORD: <app-user-password>
